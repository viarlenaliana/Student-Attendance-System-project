# Sao chép tệp này thành .env và điền giá trị thật trên máy của bạn (KHÔNG commit .env lên Git)

# Khóa bảo mật phiên đăng nhập Flask (nên tạo chuỗi ngẫu nhiên dài)
SECRET_KEY=replace-with-a-random-long-secret-key
SESSION_COOKIE_SECURE=false
SESSION_LIFETIME_HOURS=8

# Cấu hình cơ sở dữ liệu: mysql hoặc sqlite
DATABASE_TYPE=mysql
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DB=student_attendance
SQLITE_DB_PATH=demo.db

# Chính sách mật khẩu & OTP
PASSWORD_MIN_LENGTH=8
OTP_EXPIRY_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60

# Cấu hình Email SMTP (chỉ đặt mật khẩu ứng dụng thật trong .env cục bộ)
MAIL_ENABLED=false
MAIL_SUPPRESS_SEND=false
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USE_SSL=false
MAIL_USERNAME=your-sender-email@example.com
MAIL_PASSWORD=your-smtp-app-password-placeholder
MAIL_DEFAULT_SENDER=Student Attendance System <your-sender-email@example.com>
MAIL_TIMEOUT_SECONDS=10

# (Tùy chọn) Tạo tài khoản Admin ban đầu qua biến môi trường khi khởi tạo lần đầu
# INIT_ADMIN_USERNAME=admin
# INIT_ADMIN_EMAIL=admin@example.com
# INIT_ADMIN_FULL_NAME=System Administrator
# INIT_ADMIN_PASSWORD=replace-with-strong-initial-password
